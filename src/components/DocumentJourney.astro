---
import { documents } from '../data/documents.mjs';
const base = import.meta.env.BASE_URL;
const steps=[
 {title:'Constituir la sociedad',entity:'Accionistas · documento privado',explanation:'Definir estatutos, denominación, objeto social, capital, acciones y representación legal. En el supuesto se incluyen dos accionistas y un capital de $30.000.000.',result:'Documento de constitución preparado'},
 {title:'Preparar la matrícula de la S.A.S.',entity:'Cámara de Comercio · RUES sociedad',explanation:'Diligenciar la información de la persona jurídica y su matrícula mercantil. La existencia jurídica frente a terceros requiere la inscripción en el registro mercantil; el formulario por sí solo no la demuestra.',result:'Solicitud registral ilustrada'},
 {title:'Registrar el establecimiento',entity:'Cámara de Comercio · Anexo 1 RUES',explanation:'Documentar la matrícula proyectada de NexoByte Centro de Servicios Tecnológicos, distinguiendo el establecimiento de la sociedad titular.',result:'Registro del establecimiento ilustrado'},
 {title:'Identificación tributaria',entity:'DIAN · RUT',explanation:'Identificar las obligaciones y datos tributarios aplicables a la sociedad. En la práctica deben coordinarse los trámites de registro mercantil y RUT según el procedimiento vigente; no siempre son pasos estrictamente consecutivos.',result:'RUT académico elaborado'},
 {title:'Identificar responsabilidades',entity:'DIAN · carta de apoyo académico',explanation:'Revisar renta, retención, contabilidad, IVA y facturación electrónica de acuerdo con el supuesto. La carta del ejercicio complementa el expediente, pero no reemplaza el RUT ni constituye un trámite autónomo obligatorio.',result:'Responsabilidades del supuesto documentadas'}
];
---
<div class="journey-shell" aria-label="Ruta interactiva de documentos de NexoByte"><div class="journey-heading"><div><h3>Ruta documental interactiva</h3><p>Selecciona un paso para conocer su finalidad, la entidad relacionada y el anexo que lo ilustra.</p></div><span class="journey-chip">5 etapas · Simulación</span></div>
<div class="journey-steps">{steps.map((step,i)=><details class="journey-step" open={i===0}><summary><span class="journey-count">{String(i+1).padStart(2,'0')}</span><span class="journey-summary"><b>{step.title}</b><small>Anexo {documents[i].code} · {step.entity}</small></span><span class="journey-chevron" aria-hidden="true">⌄</span></summary><div class="journey-body"><p>{step.explanation}</p><p class="journey-result"><strong>Resultado en el ejercicio:</strong> {step.result}</p><div class="journey-links"><a href={`#tarjeta-anexo-${documents[i].code.toLowerCase()}`}>Ver ficha del anexo ↓</a><a href={`${base}documentos/${documents[i].code.toLowerCase()}/`}>Abrir visor PDF ↗</a></div></div></details>)}</div>
<div class="journey-finish"><span>✓ Expediente de formalización académica</span><a href={`${base}siad/`}>Siguiente: operación mercantil SIAD →</a></div><p class="journey-note"><strong>Importante:</strong> esta secuencia organiza los anexos del trabajo, no sustituye una guía oficial de radicación ni acredita que los registros se hayan efectuado.</p></div>