---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
 {name:'Inicio', href:base},
 {name:'NexoByte',href:`${base}empresa/`},
 {name:'Servicios',href:`${base}servicios/`},
 {name:'Formalización',href:`${base}formalizacion/`},
 {name:'Caso SIAD',href:`${base}siad/`},
 {name:'Marco jurídico',href:`${base}marco-juridico/`},
];
const active = (url) => url === base ? path === base : path.startsWith(url);
---
<header class="nav"><div class="container nav-inner">
<a class="brand" href={base} aria-label="NexoByte, página de inicio"><span class="brand-logo">N</span><span>NexoByte S.A.S.<small>Centro de Servicios Tecnológicos</small></span></a>
<nav class="links shared-links" aria-label="Navegación principal">
{nav.map(item=><a href={item.href} aria-current={active(item.href)?'page':undefined}>{item.name}</a>)}
<details class="nav-more"><summary>Más <span aria-hidden="true">⌄</span></summary><div class="nav-more-panel">
<a href={`${base}#clientes`}>Clientes potenciales</a>
<a href={`${base}#documentos`}>Anexos PDF</a>
<a href={`${base}#integrantes`}>Integrantes</a>
<a href={`${base}#conclusiones`}>Conclusiones</a>
</div></details>
</nav><details class="mobile-navigation"><summary aria-label="Abrir o cerrar menú de navegación"><span class="mobile-hamburger" aria-hidden="true">☰</span> Menú</summary><nav class="mobile-navigation-panel" aria-label="Navegación móvil">{nav.map(item=><a href={item.href} aria-current={active(item.href)?'page':undefined}>{item.name}</a>)}<a href={`${base}#clientes`}>Clientes potenciales</a><a href={`${base}#documentos`}>Anexos PDF</a><a href={`${base}#integrantes`}>Integrantes</a><a href={`${base}#conclusiones`}>Conclusiones</a></nav></details><a class="nav-cta" href={`${base}#documentos`}>Ver anexos ↗</a>
</div></header>
