---
const base=import.meta.env.BASE_URL;
const serviceMap=[
{type:'Logística',needs:['Seguimiento de despachos','Integración operativa','Reportes de estados'],solution:'SIAD es el ejemplo contractual del ejercicio: gestionar órdenes y mejorar la trazabilidad de despachos.'},
{type:'Comercio',needs:['Control de solicitudes','Organización de información','Automatización de tareas'],solution:'Ejemplo ilustrativo de digitalización administrativa; no corresponde a clientes reales.'},
{type:'Pymes',needs:['Diagnóstico tecnológico','Herramientas a medida','Implementación y soporte'],solution:'Servicios orientados a necesidades de digitalización y adopción tecnológica.'}
];
---
<section class="s8-service-vis" aria-label="Relación de servicios y clientes"><div class="section-kicker">Exploración visual</div><h2>¿Qué solución necesita cada cliente?</h2><p>Selecciona un tipo de organización para explorar las necesidades y los servicios que NexoByte podría ofrecer en el ejercicio académico.</p>
<div class="s8-tabs" role="group" aria-label="Tipos de clientes">{serviceMap.map((s,i)=><button type="button" class="s8-tab" data-s8-tab={i} aria-pressed={i===0?'true':'false'}>{s.type}</button>)}</div>
<div class="s8-service-grid"><div class="s8-illustration"><div class="s8-dashboard"><div class="s8-app-top"><span>● ● ●</span><b>NEXOBYTE / OPERACIONES</b></div><div class="s8-app-body"><div class="s8-side"><i></i><i></i><i></i><i></i></div><div class="s8-main"><strong>Panel operativo</strong><div class="s8-fake-kpis"><span>Órdenes</span><span>Estados</span><span>Reportes</span></div><div class="s8-fake-chart"><span></span><span></span><span></span><span></span><span></span></div><div class="s8-fake-lines"><i></i><i></i><i></i></div></div></div></div><small>Ilustración conceptual de software, no captura de un producto construido.</small></div><div class="s8-service-info"><h3 data-s8-title>Logística</h3><ul data-s8-needs>{serviceMap[0].needs.map(v=><li>{v}</li>)}</ul><p data-s8-solution>{serviceMap[0].solution}</p><a href={`${base}siad/`} class="outline-link">Explorar el ejemplo SIAD ↗</a></div></div>
<script define:vars={{serviceMap}}>const tabs=[...document.querySelectorAll('[data-s8-tab]')];const title=document.querySelector('[data-s8-title]');const needs=document.querySelector('[data-s8-needs]');const solution=document.querySelector('[data-s8-solution]');tabs.forEach(button=>button.addEventListener('click',()=>{const item=serviceMap[Number(button.dataset.s8Tab)];tabs.forEach(t=>t.setAttribute('aria-pressed',String(t===button)));title.textContent=item.type;needs.replaceChildren(...item.needs.map(x=>{const li=document.createElement('li');li.textContent=x;return li}));solution.textContent=item.solution;}));</script></section>