---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const documentos = [
  { code: 'A', title: 'Documento privado de constitución', description: 'Estatutos, capital, accionistas y representación legal.' },
  { code: 'B', title: 'RUES de la sociedad', description: 'Simulación de matrícula mercantil como persona jurídica.' },
  { code: 'C', title: 'RUES Anexo 1', description: 'Matrícula del establecimiento de comercio.' },
  { code: 'D', title: 'Registro Único Tributario', description: 'Formulario RUT académico y clasificación tributaria.' },
  { code: 'E', title: 'Carta de responsabilidades', description: 'Responsabilidades tributarias definidas para el supuesto.' },
];
const ruta = [
  ['01','Elección de S.A.S.','Características societarias y fundamento en la Ley 1258 de 2008.'],
  ['02','Constitución','Accionistas, estatutos, administración y aportes de capital.'],
  ['03','Registro mercantil','Formalización proyectada ante la Cámara de Comercio.'],
  ['04','RUT y obligaciones','Clasificación tributaria simulada, sin NIT real.'],
  ['05','Operación comercial','Contrato SIAD, medios de pago y protección del software.'],
];
---
<!doctype html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Expediente académico interactivo de NexoByte S.A.S. — simulación jurídica del curso Legislación Comercial de la UNAD."/><title>NexoByte S.A.S. | Expediente académico UNAD</title></head>
<body>
<header class="nav"><div class="container"><a class="brand" href={base}>NexoByte <small>EXPEDIENTE ACADÉMICO</small></a><nav aria-label="Navegación principal" class="links"><a href="#proyecto">Proyecto</a><a href="#sociedad">Sociedad</a><a href="#formalizacion">Formalización</a><a href="#caso">Caso SIAD</a><a href="#documentos">Documentos</a><a href="#fuentes">Fuentes</a></nav></div></header>
<main>
<section class="hero"><div class="container hero-grid"><div><span class="kicker">Universidad Nacional Abierta y a Distancia · Tarea 3</span><h1>De la constitución a la operación comercial</h1><p>Una exploración práctica de la legislación comercial colombiana a través de NexoByte S.A.S., una sociedad tecnológica ficticia creada con fines educativos.</p><div class="actions"><a class="btn" href="#formalizacion">Explorar el expediente ↓</a><a class="btn alt" href="#documentos">Documentos del caso</a></div><p class="small-note" style="color:#dbeaff">Simulación académica · Sin existencia jurídica, matrícula ni registro tributario efectivo.</p></div><aside class="hero-card" aria-label="Cifras del caso"><span>Capital autorizado, suscrito y pagado</span><strong>$30.000.000</strong><hr/><span>Accionistas</span><strong>2</strong><hr/><span>Contrato tecnológico hipotético</span><strong>$15.000.000</strong></aside></div></section>
<section class="section white" id="proyecto"><div class="container"><span class="eyebrow">El proyecto</span><h2>La legislación aplicada a un caso empresarial</h2><p class="intro">Este recurso acompaña la Tarea 3 de Legislación Comercial Nacional e Internacional (grupo 102998054_66). Explica la constitución de una S.A.S., la preparación de registros comerciales y tributarios, y la aplicación de instrumentos jurídicos a una negociación tecnológica simulada.</p><div class="grid"><article class="card"><div class="stat">S.A.S.</div><h3>Sociedad simplificada</h3><p>Figura societaria regulada por la Ley 1258 de 2008.</p></article><article class="card"><div class="stat">5</div><h3>Anexos de formalización</h3><p>Documentos académicos para explicar la ruta de registro.</p></article><article class="card"><div class="stat">SIAD</div><h3>Supuesto comercial</h3><p>Desarrollo de software para una compañía logística ficticia.</p></article></div></div></section>
<section class="section" id="sociedad"><div class="container"><span class="eyebrow">Estructura societaria</span><h2>¿Cómo se organiza NexoByte S.A.S.?</h2><div class="split"><article class="card"><h3>Composición accionaria</h3><div class="ownership" aria-label="60 por ciento Carlos Martínez; 40 por ciento Juan Pablo Pérez Torres"><div class="share1">60 %</div><div class="share2">40 %</div></div><p><strong>Carlos Martínez:</strong> 600 acciones · $18.000.000 · representante legal principal.</p><p><strong>Juan Pablo Pérez Torres:</strong> 400 acciones · $12.000.000 · representante legal suplente.</p><p class="small-note">1.000 acciones ordinarias nominativas, valor nominal de $30.000 cada una.</p></article><article class="card"><h3>Balance de apertura</h3><p><strong>Activos:</strong> $30.000.000 en efectivo.</p><p><strong>Pasivos:</strong> $0.</p><p><strong>Patrimonio:</strong> $30.000.000.</p><hr/><p><strong>Actividad CIIU principal:</strong> 6202 · consultoría informática.</p><p><strong>Actividad secundaria:</strong> 6209 · otros servicios informáticos.</p><p><strong>Establecimiento:</strong> NexoByte Centro de Servicios Tecnológicos.</p></article></div></div></section>
<section class="section white" id="formalizacion"><div class="container"><span class="eyebrow">Ruta de formalización</span><h2>Del acuerdo societario a la actividad comercial</h2><p class="intro">La secuencia es explicativa: ninguno de estos trámites se presenta como completado ante las autoridades.</p><div class="steps">{ruta.map(([n,title,detail])=><article class="step"><span class="num">{n}</span><strong>{title}</strong><p>{detail}</p></article>)}</div></div></section>
<section class="section" id="caso"><div class="container"><span class="eyebrow">Supuesto comercial</span><h2>Proyecto SIAD · Automatización de despachos</h2><p class="intro">NexoByte S.A.S. propone a Logística del Centro S.A. desarrollar el Sistema Inteligente de Automatización de Despachos (SIAD), con un plazo hipotético de 60 días calendario.</p><div class="money"><article class="card"><span class="tag">50 % · Anticipo</span><div class="stat">$7.500.000</div><p>Cheque emitido por la contratante. El comienzo del proyecto depende del cobro efectivo, según el supuesto contractual.</p></article><article class="card"><span class="tag">50 % · Saldo</span><div class="stat">$7.500.000</div><p>Factura electrónica a 30 días. Solo podrá adquirir calidad de título valor si cumple los requisitos legales correspondientes.</p></article></div><div class="grid" style="margin-top:18px"><article class="card"><h3>Contrato mercantil</h3><p>Objeto, entregables, plazos, pagos, confidencialidad y aceptación.</p></article><article class="card"><h3>Propiedad intelectual</h3><p>Licencia de uso no exclusiva del software y delimitación de derechos patrimoniales.</p></article><article class="card"><h3>Riesgos jurídicos</h3><p>Prevención de incumplimientos, problemas de cobro y uso no autorizado de activos intangibles.</p></article></div></div></section>
<section class="section white" id="documentos"><div class="container"><span class="eyebrow">Expediente documental</span><h2>Cinco anexos para entender la formalización</h2><p class="intro">Las versiones públicas de los formularios aún requieren revisión de privacidad y legibilidad. El visor y la descarga se activarán después de aprobar esas copias, sin exponer los originales.</p><div class="grid">{documentos.map(d=><article class="card doc"><span class="docicon" aria-hidden="true">📄</span><h3>Anexo {d.code}: {d.title}</h3><p>{d.description}</p><span class="tag">Simulación académica</span><div class="doc-actions"><button class="btn" disabled aria-disabled="true" title="Documento pendiente de revisión pública">Ver PDF · próximamente</button><button class="btn alt" disabled aria-disabled="true">Descargar · próximamente</button></div></article>)}</div><p class="warning" style="margin-top:22px"><strong>Aviso:</strong> los formularios ilustran procedimientos registrales y tributarios. No acreditan la existencia de NexoByte S.A.S., la asignación de un NIT ni inscripciones oficiales.</p></div></section>
<section class="section" id="fuentes"><div class="container"><span class="eyebrow">Cierre académico</span><h2>Aprendizajes y fundamentos jurídicos</h2><div class="split"><article class="card"><h3>Conclusión del caso</h3><p>La formalización societaria, los contratos mercantiles, los títulos valores y la propiedad intelectual se complementan para organizar relaciones comerciales y gestionar riesgos.</p><p class="small-note">Las conclusiones individuales de los integrantes se incorporarán solo cuando estén aprobadas.</p></article><article class="card"><h3>Fuentes principales</h3><div class="refs">Ley 1258 de 2008 · Sociedades por Acciones Simplificadas.<br/>Decreto 410 de 1971 · Código de Comercio.<br/>Ley 23 de 1982 · Derecho de autor.<br/>DIAN · Factura electrónica y RADIAN.<br/>DNDA y SIC · Derechos de autor y signos distintivos.</div><p class="small-note">Bibliografía APA 7 y fuentes completas pendientes de conciliación con el informe definitivo.</p></article></div></div></section>
</main><footer class="footer"><div class="container"><strong>NexoByte S.A.S. · Caso académico UNAD</strong><p>Curso Legislación Comercial Nacional e Internacional · Grupo 102998054_66</p><p>Proyecto educativo ficticio. Ninguna información constituye asesoría jurídica individual ni certificado expedido por una autoridad.</p></div></footer>
</body></html>