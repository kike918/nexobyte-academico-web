---
import '../styles/global.css';
import { documents } from '../data/documents.mjs';
const base = import.meta.env.BASE_URL;
const icon = (name) => name;
const timeline = [
 {n:'01',glyph:'▤',title:'Constitución',desc:'Documento privado, estatutos, accionistas y capital social.'},
 {n:'02',glyph:'▥',title:'Registro mercantil',desc:'Formulario RUES para la sociedad ante la Cámara de Comercio.'},
 {n:'03',glyph:'▣',title:'Establecimiento',desc:'Anexo 1 del RUES para el centro de servicios tecnológicos.'},
 {n:'04',glyph:'▤',title:'Registro tributario',desc:'RUT y responsabilidades proyectadas para el ejercicio.'},
 {n:'05',glyph:'✓',title:'Operación comercial',desc:'Contrato SIAD, títulos valores y licenciamiento de software.'},
];
const laws = [
 {symbol:'⚖',title:'Sociedades comerciales',source:'Ley 1258 de 2008',detail:'La S.A.S. facilita una estructura flexible de capital y administración. Se simula su constitución con dos accionistas, patrimonio inicial de $30 millones y responsabilidad delimitada según la ley.'},
 {symbol:'▤',title:'Contratos mercantiles',source:'Código de Comercio',detail:'El contrato del proyecto SIAD precisa objeto, plazo de 60 días, entregables, condiciones de pago y responsabilidades. La documentación contractual permite administrar riesgos de incumplimiento.'},
 {symbol:'◉',title:'Títulos valores',source:'Cheque y factura electrónica',detail:'El cheque se contempla para el anticipo. La factura electrónica del saldo solo puede operar como título valor cuando cumpla los requisitos legales de emisión, recepción y aceptación aplicables.'},
 {symbol:'◇',title:'Propiedad intelectual',source:'Software y derechos de autor',detail:'El caso distingue la titularidad del software de la licencia de uso no exclusiva e intransferible, además de la confidencialidad y protección de signos distintivos.'},
];
const objective = ['Consultoría tecnológica y servicios informáticos','Desarrollo e implementación de soluciones de software','Soporte, integración y acompañamiento técnico'];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="NexoByte S.A.S.: caso académico UNAD de constitución, formalización comercial y contrato tecnológico SIAD."/>
<meta name="theme-color" content="#071c39"/>
<title>NexoByte S.A.S. | Proyecto académico · UNAD</title>
</head>
<body>
<header class="nav"><div class="container nav-inner">
<a class="brand" href={base} aria-label="NexoByte, inicio"><span class="brand-logo">N</span><span>NexoByte S.A.S.<small>Centro de Servicios Tecnológicos</small></span></a>
<nav aria-label="Navegación principal" class="links">
<a href="#inicio">Inicio</a><a href="#proyecto">Proyecto</a><a href="#empresa">Empresa</a><a href="#servicios">Servicios</a><a href="#clientes">Clientes</a><a href="#sociedad">Constitución</a><a href="#formalizacion">Formalización</a><a href="#caso">Caso comercial</a><a href="#marco">Marco jurídico</a><a href="#documentos">Documentos</a><a href="#conclusiones">Conclusiones</a>
</nav><a href="#documentos" class="nav-cta">Ver anexos ↗</a>
</div></header>
<main>
<section id="inicio" class="hero">
<div class="container hero-grid">
<div class="hero-copy">
<span class="hero-kicker">PROYECTO ACADÉMICO · UNAD</span>
<h1>NexoByte <em>S.A.S.</em><span>Centro de Servicios Tecnológicos</span></h1>
<p class="hero-description">Constitución empresarial, formalización jurídica y aplicación de la legislación comercial colombiana en un caso práctico del sector tecnológico.</p>
<div class="hero-meta"><span><b>✧</b> Legislación Comercial<br/>Nacional e Internacional</span><span><b>♙</b> Grupo<br/>102998054_66</span><span><b>▦</b> Entrega<br/>Octubre 2026</span></div>
<div class="actions"><a class="btn" href="#proyecto">Conocer el proyecto ↓</a><a class="btn alt" href="#documentos">Consultar documentos ↗</a></div>
</div>
<div class="hero-art" aria-label="Representación gráfica de un equipo con el logo de NexoByte">
<div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
<div class="laptop"><div class="laptop-camera"></div><div class="laptop-display"><span class="laptop-mark">N</span><strong>NexoByte</strong><small>Soluciones tecnológicas</small><span class="screen-trace"></span></div><div class="laptop-base"></div></div>
<div class="hero-benefits"><span>⚙ &nbsp; Tecnología</span><span>♧ &nbsp; Cumplimiento</span><span>▥ &nbsp; Confianza</span><span>♧ &nbsp; Crecimiento</span></div>
<div class="hero-note"><strong>Simulación académica</strong><span>Sin validez registral o comercial real.<br/>Proyecto desarrollado para fines educativos.</span></div>
</div>
</div></section>
<section id="proyecto" class="section section-white">
<div class="container project-grid">
<div><div class="section-kicker">01. Acerca del proyecto</div><h2>Un caso empresarial para aplicar la legislación comercial</h2>
<p>NexoByte S.A.S. es una sociedad por acciones simplificada <strong>ficticia</strong>, creada por el grupo 102998054_66 como caso de estudio de Legislación Comercial Nacional e Internacional de la UNAD.</p>
<p>El ejercicio conecta el perfil de una empresa B2B de consultoría, desarrollo de software e implementación tecnológica con los documentos de formalización y una operación mercantil concreta: el desarrollo del sistema SIAD para una empresa de logística.</p>
<a href="#sociedad" class="outline-link">Explorar la estructura de la sociedad ↓</a></div>
<div class="project-right">
<div class="metric-grid"><article class="metric"><span class="metric-symbol">♙</span><strong>2</strong><b>Accionistas</b><small>Participación 60 % / 40 %</small></article><article class="metric"><span class="metric-symbol">▤</span><strong>$30.000.000</strong><b>Capital social</b><small>Autorizado, suscrito y pagado</small></article><article class="metric"><span class="metric-symbol">▣</span><strong>$15.000.000</strong><b>Caso comercial</b><small>Contrato tecnológico SIAD</small></article></div>
<div class="why-card"><div class="why-icon">⚖</div><div><strong>¿Por qué una S.A.S.?</strong><ul><li>Flexibilidad para la constitución y administración</li><li>Separación patrimonial y responsabilidad societaria</li><li>Adecuada para emprendimientos tecnológicos</li><li>Regulada por la Ley 1258 de 2008</li></ul></div></div>
</div></div></section>
<section id="empresa" class="section section-white"><div class="container"><div class="section-kicker">02. Perfil empresarial de NexoByte</div><h2 class="section-title">Tecnología para organizar, conectar y mejorar operaciones</h2><p class="section-intro">En el escenario académico, <strong>NexoByte S.A.S.</strong> es una empresa bogotana de servicios tecnológicos que acompaña a otras organizaciones en el análisis de sus procesos, el desarrollo de soluciones informáticas y su implementación. Su establecimiento proyectado es <strong>NexoByte Centro de Servicios Tecnológicos</strong>, ubicado en Bogotá D. C. Esta es una caracterización del negocio ficticio, no una empresa que esté ofreciendo servicios reales.</p><div class="profile-grid"><article class="profile-card"><span class="profile-icon">▤</span><h3>¿Qué problema resuelve?</h3><p>Las empresas que todavía dependen de registros manuales, hojas de cálculo aisladas o procesos desconectados pueden presentar duplicidad de información y dificultades de seguimiento. NexoByte plantea soluciones para digitalizar tareas, centralizar datos y mejorar la trazabilidad operativa.</p></article><article class="profile-card"><span class="profile-icon">⌁</span><h3>Propuesta de valor</h3><p>Combinar diagnóstico de procesos, desarrollo de software y acompañamiento técnico para que las herramientas respondan a necesidades concretas del cliente, con entregables, plazos y responsabilidades documentados.</p></article><article class="profile-card"><span class="profile-icon">◈</span><h3>Modelo de atención</h3><p>Servicio empresarial por proyectos: identificación de necesidades, propuesta y contrato, implementación, pruebas, entrega y soporte según lo pactado. El proyecto SIAD ejemplifica esta secuencia comercial.</p></article></div></div></section>
<section id="servicios" class="section section-tint"><div class="container"><div class="section-kicker">03. Portafolio proyectado</div><h2 class="section-title">Servicios que ofrecería NexoByte S.A.S.</h2><p class="section-intro">El siguiente portafolio desarrolla de forma ilustrativa las actividades tecnológicas asociadas al objeto social del caso. No representa contratos existentes ni ventas efectivamente realizadas.</p><div class="service-grid"><article class="service-card"><span class="profile-icon">◎</span><h3>Consultoría informática</h3><p>Diagnóstico de procesos, levantamiento de requerimientos y orientación sobre soluciones tecnológicas para la gestión empresarial.</p><small>Relacionado con CIIU 6202</small></article><article class="service-card"><span class="profile-icon">▣</span><h3>Desarrollo de software</h3><p>Diseño, construcción y adaptación de sistemas para registrar operaciones, gestionar información y automatizar tareas.</p><small>Servicio contemplado en el supuesto empresarial</small></article><article class="service-card"><span class="profile-icon">↔</span><h3>Integración y automatización</h3><p>Conexión de procesos y fuentes de información para reducir operaciones repetitivas y mejorar la trazabilidad.</p><small>Aplicación práctica: proyecto SIAD</small></article><article class="service-card"><span class="profile-icon">⚙</span><h3>Implementación y soporte</h3><p>Configuración, pruebas funcionales, capacitación inicial y acompañamiento técnico conforme a las condiciones contratadas.</p><small>Actividades tecnológicas complementarias</small></article></div></div></section>
<section id="clientes" class="section section-white"><div class="container"><div class="section-kicker">04. Mercado objetivo del caso</div><h2 class="section-title">¿Qué tipos de clientes podría atender?</h2><p class="section-intro">Como empresa B2B simulada, NexoByte orientaría sus servicios a organizaciones que necesitan digitalizar y controlar sus operaciones. Estos segmentos son <strong>clientes potenciales hipotéticos</strong>, no una cartera comercial real.</p><div class="customer-grid"><article class="customer-card"><span class="profile-icon">▥</span><h3>Logística y distribución</h3><p>Empresas de despachos, transporte y distribución que necesitan seguimiento de pedidos, rutas y estados operativos.</p><div class="customer-example">Ejemplo del ejercicio: Logística del Centro S.A. y el sistema SIAD</div></article><article class="customer-card"><span class="profile-icon">▦</span><h3>Comercio y servicios</h3><p>Negocios que buscan organizar solicitudes, información de clientes, inventarios o procesos administrativos.</p><div class="customer-example">Ejemplo ilustrativo: digitalización de registros operativos</div></article><article class="customer-card"><span class="profile-icon">♧</span><h3>Pequeñas y medianas empresas</h3><p>Organizaciones en crecimiento que requieren asesoría tecnológica, aplicaciones sencillas o mejoras de procesos.</p><div class="customer-example">Ejemplo ilustrativo: consultoría e implementación por etapas</div></article></div><div class="business-flow"><b>Necesidad del cliente</b><span>→</span><b>Consultoría y propuesta</b><span>→</span><b>Contrato mercantil</b><span>→</span><b>Solución y soporte</b></div></div></section>
<section id="sociedad" class="section section-tint"><div class="container">
<div class="two-headings"><div class="section-kicker">05. Composición accionaria y administración</div><div class="section-kicker">06. Objeto social y actividad económica</div></div>
<div class="company-grid">
<div class="company-panel"><div class="owner-group"><div class="donut" role="img" aria-label="Carlos Martínez 60 por ciento y Juan Pablo Pérez Torres 40 por ciento"><div class="donut-hole"><strong>$30.000.000</strong><small>Capital social</small></div></div><div class="shareholders"><div class="shareholder"><span class="avatar">♙</span><div><strong>Carlos Martínez</strong><small>Accionista · Representante legal principal<br/>600 acciones · $18.000.000</small></div><b class="share-tag tag-blue">60 %</b></div><div class="shareholder"><span class="avatar teal">♙</span><div><strong>Juan Pablo Pérez Torres</strong><small>Accionista · Representante legal suplente<br/>400 acciones · $12.000.000</small></div><b class="share-tag tag-teal">40 %</b></div></div></div><p class="fine-print">1.000 acciones ordinarias de $30.000 cada una. La suplencia de la representación se ejerce bajo los supuestos previstos en los estatutos académicos.</p></div>
<div class="activity-grid"><article class="compact-card"><span class="card-symbol">◎</span><h3>Objeto social</h3><p>Prestación de servicios de consultoría, desarrollo de software, implementación de soluciones tecnológicas, soporte técnico y actividades relacionadas con tecnologías de la información.</p></article><article class="compact-card"><span class="card-symbol">▥</span><h3>Actividad económica (CIIU)</h3><p><b>6202</b> · Consultoría informática (principal)</p><p><b>6209</b> · Otras actividades de tecnologías de información y servicios informáticos (secundaria)</p><p class="fine-print">Establecimiento: NexoByte Centro de Servicios Tecnológicos.</p></article></div></div></div></section>
<section id="formalizacion" class="section section-white"><div class="container"><div class="section-kicker">07. Ruta de formalización empresarial</div><h2 class="section-title">Del acuerdo societario a la operación comercial</h2><p class="section-intro">Secuencia educativa de los procedimientos y documentos previstos para una nueva sociedad. No corresponde a registros efectivamente tramitados.</p><div class="timeline">{timeline.map(step=><article class="timeline-step"><div class="timeline-top"><span class="step-number">{step.n}</span><span class="step-icon">{step.glyph}</span></div><h3>{step.title}</h3><p>{step.desc}</p></article>)}</div>
<div class="opening-balance"><span>Balance inicial del supuesto:</span><b>Activos $30.000.000</b><span>−</span><b>Pasivos $0</b><span>=</span><b>Patrimonio $30.000.000</b></div></div></section>
<section id="caso" class="section section-tint"><div class="container"><div class="section-kicker">08. Caso comercial: Proyecto SIAD</div><div class="case-grid"><div class="siad-graphic"><div class="graphic-grid"></div><div class="truck" aria-hidden="true"><span class="truck-box">SIAD</span><span class="truck-cab">▰</span><span class="wheel one"></span><span class="wheel two"></span></div><div class="siad-caption"><strong>Desarrollo e implementación<br/>del sistema SIAD</strong><span>Logística del Centro S.A.<br/>Valor del contrato: <b>$15.000.000 COP</b></span></div></div><div class="case-detail"><h2>SIAD: un servicio de NexoByte aplicado a logística</h2><p>Contrato hipotético para diseñar e implementar el <strong>Sistema Inteligente de Automatización de Despachos</strong>, con una ejecución proyectada de <strong>60 días calendario</strong>.</p><div class="payment-rows"><div><span class="payment-icon">➜</span><span><b>Anticipo · 50 % — $7.500.000</b><small>Mediante cheque, sujeto a las condiciones pactadas y a su cobro efectivo.</small></span></div><div><span class="payment-icon">➜</span><span><b>Saldo · 50 % — $7.500.000</b><small>Factura electrónica, con pago a 30 días conforme al supuesto contractual.</small></span></div><div><span class="payment-icon">▤</span><span><b>Instrumentos aplicados</b><small>Contrato mercantil, cheque, factura electrónica y licencia de software.</small></span></div></div></div></div></div></section>
<section id="marco" class="section section-white"><div class="container"><div class="section-kicker">09. Marco jurídico aplicado</div><h2 class="section-title">Fundamentos que sustentan el ejercicio</h2><div class="law-grid">{laws.map(l=><article class="law-card"><span class="law-icon">{l.symbol}</span><div><h3>{l.title}</h3><strong>{l.source}</strong><p>{l.detail}</p></div></article>)}</div></div></section>
<section id="documentos" class="section section-tint"><div class="container"><div class="section-kicker">10. Expediente documental</div><h2 class="section-title">Anexos de formalización</h2><p class="section-intro">Copias de la entrega académica actual, identificadas como simulación y disponibles para consultar en el visor integrado o descargar en PDF. Se actualizarán al consolidar el trabajo del grupo.</p>
<div class="documents-grid">{documents.map(d=><article class="document-card"><div class="document-preview"><iframe title={`Vista previa del Anexo ${d.code}`} src={`${base}documentos/${d.filename}#page=1&toolbar=0&navpanes=0&scrollbar=0`} loading="lazy" tabindex="-1"></iframe><span class="doc-label">ANEXO {d.code}</span></div><div class="document-body"><h3>{d.title}</h3><p>{d.description}</p><div class="document-actions"><a href={`${base}documentos/${d.code.toLowerCase()}/`} class="outline-link">Ver documento ↗</a><a href={`${base}documentos/${d.filename}`} class="download-link" download={d.filename}>Descargar ↓</a></div></div></article>)}</div>
<div class="disclaimer">▣ &nbsp; <strong>Simulación académica — Sin validez registral.</strong> Los formularios no acreditan existencia jurídica, matrícula mercantil, asignación de NIT ni actuaciones realizadas ante autoridades.</div></div></section>
<section id="conclusiones" class="section section-white"><div class="container closing-grid"><div><div class="section-kicker">11. Conclusiones</div><h2>Aprendizajes del ejercicio</h2><p>El caso permitió relacionar la formalización de una sociedad con decisiones comerciales concretas: elección de figura jurídica, estructuración del capital, preparación documental, contratación, cobro y protección del software.</p><p>Las conclusiones de los demás integrantes se incorporarán después de su entrega y revisión. Esta publicación es una <strong>versión académica preliminar</strong>.</p><a href="#proyecto" class="outline-link">Volver al inicio ↑</a></div><div><div class="section-kicker">Bibliografía y fuentes</div><h2>Marco documental de consulta</h2><ul class="bibliography"><li>Congreso de Colombia. Ley 1258 de 2008 (S.A.S.).</li><li>Presidencia de la República de Colombia. Decreto 410 de 1971 (Código de Comercio).</li><li>Congreso de Colombia. Ley 23 de 1982 (derechos de autor).</li><li>DIAN. Facturación electrónica y RADIAN.</li><li>DNDA y SIC. Protección de software y signos distintivos.</li></ul><p class="fine-print">Referencias completas en formato APA pendientes de conciliar con el informe definitivo de la Tarea 3.</p></div></div></section>
</main>
<footer class="footer"><div class="container footer-grid"><a class="brand brand-light" href={base}><span class="brand-logo">N</span><span>NexoByte S.A.S.<small>Centro de Servicios Tecnológicos</small></span></a><div>Proyecto académico · UNAD<br/>Legislación Comercial Nacional e Internacional<br/>Grupo 102998054_66 · Octubre de 2026</div><div><strong>Simulación académica</strong><br/>Sin validez registral o comercial.<br/>Documentación para fines educativos.</div></div></footer>
</body></html>
